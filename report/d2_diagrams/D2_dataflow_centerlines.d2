# Centerlines + 3D bird's-eye viewer dataflow.
#
# Two diagrams in this file. Every diagram uses `direction: down`
# so arrows run top-to-bottom and enter targets at the top.
#
#   4. centerlines
#   8. Rendering - 3D bird's-eye viewer
#
# Render with:  d2 --layout=elk D2_dataflow_centerlines.d2 D2_dataflow_centerlines.svg
#
# Visual conventions
#   - SQLite tables being *populated* in a diagram use the built-in sql_table
#     shape, so columns + key constraints are visible.
#   - Tables that appear only as upstream inputs use the `table_ref` class
#     (cylinder, blue) to stay compact.
#   - nuScenes records / map API use the `nuscenes` class (page, yellow).
#   - GUI components use the `ui_element` class (rectangle, mint).

grid-rows: 1
vertical-gap: 0
horizontal-gap: 40

classes: {
  nuscenes: {
    shape: page
    style: {
      fill: "#fff4d6"
      stroke: "#8a6a00"
      font-color: "#3a2a00"
      font-size: 24
    }
  }
  table_ref: {
    shape: cylinder
    style: {
      fill: "#dbeafe"
      stroke: "#1e3a8a"
      font-color: "#0b1c40"
      font-size: 24
    }
  }
  ui_element: {
    shape: rectangle
    style: {
      fill: "#dcfce7"
      stroke: "#15803d"
      font-color: "#0a4720"
    }
  }
  config: {
    shape: rectangle
    style: {
      fill: "#f3f4f6"
      stroke: "#6b7280"
      font-color: "#374151"
    }
  }
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 4 - centerlines
# ────────────────────────────────────────────────────────────────────────────

"Populate the `centerlines` table": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#fff9e6"
    style.stroke: "#8a6a00"

    ns_map: "NuScenesMap\nAPI" { class: nuscenes }
  }

  output: {
    label: "Output table"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"

    centerlines: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      lane_token: TEXT { constraint: primary_key }
      point_idx: INTEGER { constraint: primary_key }
      x: REAL
      y: REAL
    }
  }

  inputs.ns_map -> output.centerlines: "lane centerline polylines\n(one row per vertex)" {
    style.font-size: 24
    style.font-color: "#000000"
  }
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 8 - Rendering: 3D bird's-eye viewer
# ────────────────────────────────────────────────────────────────────────────

"GUI: Render the 3D bird's-eye view of the scene": {
  direction: down

  tables: {
    label: "Tables"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    # Invisible inter-cylinder spacers spread the row to span the same
    # x-range as `viewer_3d`, so each cylinder sits under its incoming
    # edge port instead of bunched in the middle.
    ego_poses: { class: table_ref }
    spacer_1: "" { width: 50; height: 1; style.opacity: 0 }
    object_poses: { class: table_ref }
    spacer_2: "" { width: 50; height: 1; style.opacity: 0 }
    centerlines: { class: table_ref }
  }

  ui: {
    label: "GUI element"
    style.fill: "#e6f7ed"
    style.stroke: "#15803d"
    direction: down

    viewer_3d: "3D bird's-eye viewer\n\nRenders the ego and every tracked actor as\nwireframe boxes (coloured by category) for the\ncurrent keyframe, with HD-map lane centerlines\noverlaid as green polylines." {
      class: ui_element
      style.font-size: 24
    }
  }

  tables.ego_poses -> ui.viewer_3d: "ego_x/y/z,\nego_qw/qx/qy/qz" {
    style.font-size: 24
    style.font-color: "#000000"
  }
  tables.object_poses -> ui.viewer_3d: "x/y/z,\nqw/qx/qy/qz,\n w/l/h" {
    style.font-size: 24
    style.font-color: "#000000"
  }
  tables.centerlines -> ui.viewer_3d: "lane (x, y) polylines" {
    style.font-size: 24
    style.font-color: "#000000"
  }
}

"3D bird's-eye viewer": {
  style.fill: "#e6f7ed"
  style.stroke: "#15803d"

  bev_panel: "" {
    shape: image
    icon: ../report_images/bev_panel.png
    width: 550
    height: 420
  }
}

"GUI: Render the 3D bird's-eye view of the scene".ui.viewer_3d -> "3D bird's-eye viewer".bev_panel: { style.opacity: 0 }
