# Split D2 dataflow diagrams.
#
# Sixteen small diagrams in this file. Every diagram uses `direction: down`
# so arrows run top-to-bottom and enter targets at the top.
#
#   Foundational tables populated directly from nuScenes
#   (one diagram per table - full schema introduced where the table is
#   populated):
#     1. scenes
#     2. ego_poses
#     3. object_poses
#     4. centerlines
#
#   Tables populated from a foundational table (+ map / nuScenes):
#     5. object_trajectories
#     6. visibility
#
#   GUI rendering - tables appear as cylinder references with just their
#   name to keep arrows uncluttered (one diagram per UI element):
#     7. Scene header
#     8. 3D bird's-eye viewer
#     9. Trajectory overlay
#    10. Six-camera panel
#    11. Telemetry chart
#
#   Derived event tables (each diagram introduces the schema of the table(s)
#   it populates as a sql_table):
#    12. Intersection traversals - geometric data (ITGD)
#    13. Intersection traversals - kinematic classification (IT)
#    14. Pedestrian-vehicle crossings
#    15. Cut-in events
#    16. Lane-change events
#
# Render with:  d2 --layout=elk D2_dataflow.d2 D2_dataflow.svg
#
# Visual conventions
#   - SQLite tables being *populated* in a diagram use the built-in sql_table
#     shape, so columns + key constraints are visible.
#   - Tables that appear only as upstream inputs use the `table_ref` class
#     (cylinder, blue) to stay compact.
#   - nuScenes records / map API use the `nuscenes` class (page, yellow).
#   - GUI components use the `ui_element` class (rectangle, mint).
#   - Solid edges = field copied directly. Dashed edges = field derived
#     (e.g. ego_speed/ego_accel via finite-differencing).

classes: {
  nuscenes: {
    shape: page
    style: {
      fill: "#fff4d6"
      stroke: "#8a6a00"
      font-color: "#3a2a00"
    }
  }
  table_ref: {
    shape: cylinder
    style: {
      fill: "#dbeafe"
      stroke: "#1e3a8a"
      font-color: "#0b1c40"
    }
  }
  ui_element: {
    shape: rectangle
    style: {
      fill: "#dcfce7"
      stroke: "#15803d"
      font-color: "#0a4720"
    }
  }
  config: {
    shape: rectangle
    style: {
      fill: "#f3f4f6"
      stroke: "#6b7280"
      font-color: "#374151"
    }
  }
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 1 - scenes
# ────────────────────────────────────────────────────────────────────────────

"1. Population - scenes": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#fff9e6"
    style.stroke: "#8a6a00"
    direction: right

    ns_scene: "nuScenes\nscene" { class: nuscenes }
    ns_log: "nuScenes\nlog" { class: nuscenes }
  }

  output: {
    label: "Output table"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"

    scenes: {
      shape: sql_table
      scene_token: TEXT { constraint: primary_key }
      scene_name: TEXT
      location: TEXT
      data_version: TEXT
      subset: TEXT
    }
  }

  inputs.ns_scene -> output.scenes: "scene_token,\nscene_name"
  inputs.ns_log -> output.scenes: "location"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 2 - ego_poses
# ────────────────────────────────────────────────────────────────────────────

"2. Population - ego_poses": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#fff9e6"
    style.stroke: "#8a6a00"
    direction: right

    ns_sample: "nuScenes\nsample" { class: nuscenes }
    ns_ego: "nuScenes\nego_pose" { class: nuscenes }
  }

  output: {
    label: "Output table"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"

    ego_poses: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      frame_idx: INTEGER { constraint: primary_key }
      ego_x: REAL
      ego_y: REAL
      ego_z: REAL
      ego_qw: REAL
      ego_qx: REAL
      ego_qy: REAL
      ego_qz: REAL
      ego_speed: REAL
      ego_accel: REAL
    }
  }

  inputs.ns_sample -> output.ego_poses: "frame_idx ordering"
  inputs.ns_ego -> output.ego_poses: "x, y, z,\nqw, qx, qy, qz"
  inputs.ns_ego -> output.ego_poses: "ego_speed, ego_accel\n(finite-diff of position)" {
    style.stroke-dash: 4
  }
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 3 - object_poses
# ────────────────────────────────────────────────────────────────────────────

"3. Population - object_poses": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#fff9e6"
    style.stroke: "#8a6a00"
    direction: right

    ns_sample: "nuScenes\nsample" { class: nuscenes }
    ns_ann: "nuScenes\nsample_annotation" { class: nuscenes }
    ns_inst: "nuScenes\ninstance" { class: nuscenes }
    ns_cat: "nuScenes\ncategory" { class: nuscenes }
  }

  output: {
    label: "Output table"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"

    object_poses: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      frame_idx: INTEGER { constraint: primary_key }
      instance_token: TEXT { constraint: primary_key }
      category: TEXT
      x: REAL
      y: REAL
      z: REAL
      qw: REAL
      qx: REAL
      qy: REAL
      qz: REAL
      "width": REAL
      "length": REAL
      "height": REAL
      speed: REAL
      accel: REAL
    }
  }

  inputs.ns_sample -> output.object_poses.frame_idx: "frame_idx ordering"
  inputs.ns_ann -> output.object_poses: "x, y, z,\nqw, qx, qy, qz,\nw, l, h"
  inputs.ns_ann -> output.object_poses: "speed, accel\n(finite-diff of position)" {
    style.stroke-dash: 4
  }
  inputs.ns_inst -> output.object_poses: "instance_token"
  inputs.ns_cat -> output.object_poses.category: "category"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 4 - centerlines
# ────────────────────────────────────────────────────────────────────────────

"4. Population - centerlines": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#fff9e6"
    style.stroke: "#8a6a00"

    ns_map: "NuScenesMap\nAPI" { class: nuscenes }
  }

  output: {
    label: "Output table"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"

    centerlines: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      lane_token: TEXT { constraint: primary_key }
      point_idx: INTEGER { constraint: primary_key }
      x: REAL
      y: REAL
    }
  }

  inputs.ns_map -> output.centerlines: "lane centerline polylines\n(one row per vertex)"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 5 - object_trajectories (derived from object_poses)
# Same layout as the intersection-traversals diagram: cylinder input(s) on
# top, full sql_table output on the bottom.
# ────────────────────────────────────────────────────────────────────────────

"5. Population - object_trajectories": {
  direction: down

  inputs: {
    label: "Input"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"

    object_poses: { class: table_ref }
  }

  output: {
    label: "Output table"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"

    object_trajectories: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      instance_token: TEXT { constraint: primary_key }
      category: TEXT
      start_frame: INTEGER
      end_frame: INTEGER
      points_json: TEXT
    }
  }

  inputs.object_poses -> output.object_trajectories: "group by instance_token,\nJSON-pack frames"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 6 - visibility (derived from object_poses + nuScenes camera data)
# ────────────────────────────────────────────────────────────────────────────

"6. Population - visibility": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#f5f4ed"
    style.stroke: "#8a6a00"
    direction: right

    object_poses: { class: table_ref }
    ns_ann: "nuScenes\nsample_annotation" { class: nuscenes }
    ns_sd: "nuScenes\nsample_data" { class: nuscenes }
    ns_cal: "nuScenes\ncalibrated_sensor" { class: nuscenes }
  }

  output: {
    label: "Output table"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"

    visibility: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      frame_idx: INTEGER { constraint: primary_key }
      instance_token: TEXT { constraint: primary_key }
      camera: TEXT { constraint: primary_key }
      visibility_level: TEXT
      bbox_x1: REAL
      bbox_y1: REAL
      bbox_x2: REAL
      bbox_y2: REAL
    }
  }

  inputs.object_poses -> output.visibility: "3D bbox + pose\n(to project into image)"
  inputs.ns_ann -> output.visibility: "visibility_token"
  inputs.ns_sd -> output.visibility: "camera name,\nimage bounds"
  inputs.ns_cal -> output.visibility: "intrinsics, extrinsics"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 2 - Rendering: scene header + 3D viewer + trajectory overlay
# ────────────────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────────────────
# Diagram 7 - Rendering: scene header
# ────────────────────────────────────────────────────────────────────────────

"7. Rendering - scene header": {
  direction: down

  tables: {
    label: "Tables"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"

    scenes: { class: table_ref }
  }

  ui: {
    label: "GUI element"
    style.fill: "#e6f7ed"
    style.stroke: "#15803d"

    scene_header: "Scene header\n\nDisplays the scene's name, location,\ndataset version, and subset above the\nviewer." { class: ui_element }
  }

  tables.scenes -> ui.scene_header: "scene_name, location,\ndata_version, subset"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 8 - Rendering: 3D bird's-eye viewer
# ────────────────────────────────────────────────────────────────────────────

"8. Rendering - 3D bird's-eye viewer": {
  direction: down

  tables: {
    label: "Tables"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    ego_poses: { class: table_ref }
    object_poses: { class: table_ref }
    centerlines: { class: table_ref }
  }

  ui: {
    label: "GUI element"
    style.fill: "#e6f7ed"
    style.stroke: "#15803d"

    viewer_3d: "3D bird's-eye viewer\n\nRenders the ego and every tracked actor as\nwireframe boxes (coloured by category) for the\ncurrent keyframe, with HD-map lane centerlines\noverlaid as semi-transparent green polylines." { class: ui_element }
  }

  tables.ego_poses -> ui.viewer_3d: "ego_x/y/z,\nego_qw/qx/qy/qz"
  tables.object_poses -> ui.viewer_3d: "x/y/z, qw/qx/qy/qz,\nwidth/length/height,\ncategory"
  tables.centerlines -> ui.viewer_3d: "lane (x, y) polylines"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 9 - Rendering: trajectory overlay
# ────────────────────────────────────────────────────────────────────────────

"9. Rendering - trajectory overlay": {
  direction: down

  tables: {
    label: "Tables"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    ego_poses: { class: table_ref }
    object_trajectories: { class: table_ref }
  }

  ui: {
    label: "GUI element"
    style.fill: "#e6f7ed"
    style.stroke: "#15803d"

    trajectory_overlay: "Trajectory overlay\n\nFor a highlighted actor, draws its full\npolyline from the first to the last\nkeyframe at which it was tracked." { class: ui_element }
  }

  tables.ego_poses -> ui.trajectory_overlay: "ego_x/y/z\n(when ego is highlighted)"
  tables.object_trajectories -> ui.trajectory_overlay: "points_json\n(when an actor is highlighted)"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 3 - Rendering: six-camera panel
# ────────────────────────────────────────────────────────────────────────────

"10. Rendering - six-camera panel": {
  direction: down

  tables: {
    label: "Tables"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    object_poses: { class: table_ref }
    visibility: { class: table_ref }
  }

  ui: {
    label: "GUI element"
    style.fill: "#e6f7ed"
    style.stroke: "#15803d"

    camera_panel: "Six-camera panel\n\nShows the six ego-mounted camera tiles, each with\n2D bounding-box overlays for the objects visible\nin that camera at the current keyframe." { class: ui_element }
  }

  tables.object_poses -> ui.camera_panel: "category"
  tables.visibility -> ui.camera_panel: "camera, visibility_level,\nbbox_x1/y1/x2/y2"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 4 - Rendering: telemetry chart
# ────────────────────────────────────────────────────────────────────────────

"11. Rendering - telemetry chart": {
  direction: down

  tables: {
    label: "Tables"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    ego_poses: { class: table_ref }
    object_poses: { class: table_ref }
  }

  ui: {
    label: "GUI element"
    style.fill: "#e6f7ed"
    style.stroke: "#15803d"

    telemetry: "Telemetry chart\n\nPlots speed and acceleration over time for the ego\nand any highlighted actor; the cursor is kept in\nsync with the playback frame." { class: ui_element }
  }

  tables.ego_poses -> ui.telemetry: "ego_speed, ego_accel"
  tables.object_poses -> ui.telemetry: "speed, accel\n(highlighted actor)"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 12 - Derived: intersection_traversals_geometric_data (ITGD)
# Map-based detection of intersection entries/exits.
# ────────────────────────────────────────────────────────────────────────────

"12. Derived - intersection_traversals_geometric_data (ITGD)": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#f5f4ed"
    style.stroke: "#8a6a00"
    direction: right

    ego_poses: { class: table_ref }
    object_poses: { class: table_ref }
    ns_map: "NuScenesMap\nAPI" { class: nuscenes }
  }

  derived: {
    label: "Derived event table"
    style.fill: "#fdebf3"
    style.stroke: "#9d174d"

    intersection_traversals_geometric_data: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      intersection_token: TEXT
      vehicle_token: TEXT
      connector_1_start_yaw: REAL
    }
  }

  inputs.ego_poses -> derived.intersection_traversals_geometric_data: "ego (x, y)\nper frame"
  inputs.object_poses -> derived.intersection_traversals_geometric_data: "vehicle (x, y)\nper frame"
  inputs.ns_map -> derived.intersection_traversals_geometric_data: "intersection\npolygons,\nlane connectors"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 13 - Derived: intersection_traversals (IT)
# Ayres' kinematic algorithm classifies each ITGD traversal and joins back
# its frame window.
# ────────────────────────────────────────────────────────────────────────────

"13. Derived - intersection_traversals (IT)": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    ego_poses: { class: table_ref }
    object_poses: { class: table_ref }
    intersection_traversals_geometric_data: { class: table_ref }
  }

  derived: {
    label: "Derived event table"
    style.fill: "#fdebf3"
    style.stroke: "#9d174d"

    intersection_traversals: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      intersection_token: TEXT
      vehicle_token: TEXT
      start_frame: INTEGER
      end_frame: INTEGER
      maneuver: TEXT
      intersection_approach_heading: REAL
    }
  }

  inputs.ego_poses -> derived.intersection_traversals: "ego heading\n+ ego_speed"
  inputs.object_poses -> derived.intersection_traversals: "vehicle heading\n+ speed"
  inputs.intersection_traversals_geometric_data -> derived.intersection_traversals: "per-traversal\nframe window,\napproach heading"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 6 - Derived: pedestrian-vehicle crossings
# ────────────────────────────────────────────────────────────────────────────

"14. Derived - pedestrian-vehicle crossings": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    ego_poses: { class: table_ref }
    object_poses: { class: table_ref }
  }

  derived: {
    label: "Derived event table"
    style.fill: "#fdebf3"
    style.stroke: "#9d174d"

    ped_vehicle_crossings: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      ped_token: TEXT
      vehicle_token: TEXT
      ped_frame: INTEGER
      veh_frame: INTEGER
      vehicle_stopped: INTEGER
    }
  }

  inputs.ego_poses -> derived.ped_vehicle_crossings: "ego trajectory\n+ ego_speed"
  inputs.object_poses -> derived.ped_vehicle_crossings: "ped + vehicle\ntrajectories"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 7 - Derived: cut-in events
# ────────────────────────────────────────────────────────────────────────────

"15. Derived - cut-in events": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    ego_poses: { class: table_ref }
    object_poses: { class: table_ref }
  }

  derived: {
    label: "Derived event table"
    style.fill: "#fdebf3"
    style.stroke: "#9d174d"

    cutin_events: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      vehicle_id: TEXT
      start_frame: INTEGER
      end_frame: INTEGER
    }
  }

  inputs.ego_poses -> derived.cutin_events: "ego pose\n(Frenet origin)"
  inputs.object_poses -> derived.cutin_events: "non-ego vehicle poses"
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 8 - Derived: lane-change events
# ────────────────────────────────────────────────────────────────────────────

"16. Derived - lane-change events": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#f5f4ed"
    style.stroke: "#8a6a00"
    direction: right

    ego_poses: { class: table_ref }
    object_poses: { class: table_ref }
    ns_map: "NuScenesMap\nAPI" { class: nuscenes }
  }

  derived: {
    label: "Derived event table"
    style.fill: "#fdebf3"
    style.stroke: "#9d174d"

    lane_change_events: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      vehicle_id: TEXT
      start_frame: INTEGER
      end_frame: INTEGER
    }
  }

  inputs.ego_poses -> derived.lane_change_events: "ego (x, y)"
  inputs.object_poses -> derived.lane_change_events: "vehicle (x, y)"
  inputs.ns_map -> derived.lane_change_events: "lane at (x, y)\nvia record_on_point"
}
