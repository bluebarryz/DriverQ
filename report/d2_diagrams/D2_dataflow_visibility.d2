# Visibility dataflow.
#
# Two diagrams in this file. Every diagram uses `direction: down`
# so arrows run top-to-bottom and enter targets at the top.
#
#   6. visibility (derived from object_poses + nuScenes camera data)
#   10. Rendering - six-camera panel
#
# Render with:  d2 --layout=elk D2_dataflow_visibility.d2 D2_dataflow_visibility.svg
#
# Visual conventions
#   - SQLite tables being *populated* in a diagram use the built-in sql_table
#     shape, so columns + key constraints are visible.
#   - Tables that appear only as upstream inputs use the `table_ref` class
#     (cylinder, blue) to stay compact.
#   - nuScenes records / map API use the `nuscenes` class (page, yellow).
#   - GUI components use the `ui_element` class (rectangle, mint).

grid-rows: 1
vertical-gap: 0
horizontal-gap: 40

classes: {
  nuscenes: {
    shape: page
    style: {
      fill: "#fff4d6"
      stroke: "#8a6a00"
      font-color: "#3a2a00"
      font-size: 24
    }
  }
  table_ref: {
    shape: cylinder
    style: {
      fill: "#dbeafe"
      stroke: "#1e3a8a"
      font-color: "#0b1c40"
      font-size: 24
    }
  }
  ui_element: {
    shape: rectangle
    style: {
      fill: "#dcfce7"
      stroke: "#15803d"
      font-color: "#0a4720"
    }
  }
  config: {
    shape: rectangle
    style: {
      fill: "#f3f4f6"
      stroke: "#6b7280"
      font-color: "#374151"
    }
  }
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 6 - visibility (derived from object_poses + nuScenes camera data)
# ────────────────────────────────────────────────────────────────────────────

"Populate the `visibility` table": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#f5f4ed"
    style.stroke: "#8a6a00"
    direction: right

    object_poses: { class: table_ref }
    ns_ann: "nuScenes\nsample_annotation" { class: nuscenes }
    ns_sd: "nuScenes\nsample_data" { class: nuscenes }
    ns_cal: "nuScenes\ncalibrated_sensor" { class: nuscenes }
  }

  output: {
    label: "Output table"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"

    visibility: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      frame_idx: INTEGER { constraint: primary_key }
      instance_token: TEXT { constraint: primary_key }
      camera: TEXT { constraint: primary_key }
      visibility_level: TEXT
      bbox_x1: REAL
      bbox_y1: REAL
      bbox_x2: REAL
      bbox_y2: REAL
    }
  }

  inputs.object_poses -> output.visibility: "3D bbox + pose\n(to project into image)" {
    style.font-size: 24
    style.font-color: "#000000"
  }
  inputs.ns_ann -> output.visibility: "visibility_token" {
    style.font-size: 24
    style.font-color: "#000000"
  }
  inputs.ns_sd -> output.visibility: "camera name,\nimage bounds" {
    style.font-size: 24
    style.font-color: "#000000"
  }
  inputs.ns_cal -> output.visibility: "intrinsics,\nextrinsics" {
    style.font-size: 24
    style.font-color: "#000000"
  }
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram 10 - Rendering: six-camera panel
# ────────────────────────────────────────────────────────────────────────────

"GUI: Render the six-camera panel": {
  direction: down

  tables: {
    label: "Tables"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    object_poses: { class: table_ref }
    visibility: { class: table_ref }
  }

  ui: {
    label: "GUI element"
    style.fill: "#e6f7ed"
    style.stroke: "#15803d"
    direction: down

    camera_panel: "Six-camera panel" {
      class: ui_element
      style.font-size: 36
    }
  }

  tables.object_poses -> ui.camera_panel: "category" {
    style.font-size: 24
    style.font-color: "#000000"
  }
  tables.visibility -> ui.camera_panel: "camera,\nvisibility_level,\nbbox_x1/y1/x2/y2" {
    style.font-size: 24
    style.font-color: "#000000"
  }
}

"Six-camera panel": {
  style.fill: "#e6f7ed"
  style.stroke: "#15803d"
  grid-columns: 1

  camera_panel_image: "" {
    shape: image
    icon: ../report_images/6_camera_view.png
    width: 650
    height: 325
  }
  camera_panel_highlight: "" {
    shape: image
    icon: ../report_images/camera_panel_highlight.png
    width: 650
    height: 325
  }
}

"GUI: Render the six-camera panel".ui.camera_panel -> "Six-camera panel".camera_panel_image: { style.opacity: 0 }
