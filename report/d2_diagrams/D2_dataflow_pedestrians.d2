# Pedestrian-vehicle crossing dataflow.
#
# One diagram in this file. Uses `direction: down` so arrows run
# top-to-bottom and enter the target at the top.
#
#   Derived - pedestrian-vehicle crossings
#
# Render with:  d2 --layout=elk D2_dataflow_pedestrians.d2 D2_dataflow_pedestrians.svg
#
# Visual conventions
#   - SQLite tables being *populated* in a diagram use the built-in sql_table
#     shape, so columns + key constraints are visible.
#   - Tables that appear only as upstream inputs use the `table_ref` class
#     (cylinder, blue) to stay compact.
#   - nuScenes records / map API use the `nuscenes` class (page, yellow).
#   - Query / post-processing steps use the `config` class (rectangle, grey).

grid-rows: 1
vertical-gap: 0
horizontal-gap: 40

classes: {
  nuscenes: {
    shape: page
    style: {
      fill: "#fff4d6"
      stroke: "#8a6a00"
      font-color: "#3a2a00"
      font-size: 24
    }
  }
  table_ref: {
    shape: cylinder
    style: {
      fill: "#dbeafe"
      stroke: "#1e3a8a"
      font-color: "#0b1c40"
      font-size: 24
    }
  }
  ui_element: {
    shape: rectangle
    style: {
      fill: "#dcfce7"
      stroke: "#15803d"
      font-color: "#0a4720"
    }
  }
  config: {
    shape: rectangle
    style: {
      fill: "#f3f4f6"
      stroke: "#6b7280"
      font-color: "#374151"
    }
  }
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram - Derived: pedestrian-vehicle crossings
# Proximity + heading check flags frames where a ped crosses a vehicle path.
# ────────────────────────────────────────────────────────────────────────────

"Populate `ped_vehicle_crossings` table": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    ego_poses: { class: table_ref }
    object_poses: { class: table_ref }
  }

  derived: {
    label: "Derived event table"
    style.fill: "#fdebf3"
    style.stroke: "#9d174d"

    ped_vehicle_crossings: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      ped_token: TEXT
      vehicle_token: TEXT
      ped_frame: INTEGER
      veh_frame: INTEGER
      vehicle_stopped: INTEGER
    }
  }

  inputs.ego_poses -> derived.ped_vehicle_crossings: "ego trajectory,\nego_speed" {
    style.font-size: 24
    style.font-color: "#000000"
  }
  inputs.object_poses -> derived.ped_vehicle_crossings: "ped + vehicle\ntrajectories" {
    style.font-size: 24
    style.font-color: "#000000"
  }
}
