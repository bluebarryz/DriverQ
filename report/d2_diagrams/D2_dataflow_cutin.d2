# Cut-in events and kinematic features dataflow.
#
# Two diagrams in this file. Uses `direction: down` so arrows run
# top-to-bottom and enter the target at the top.
#
#   Intermediate - kinematic_features (KF)
#   Derived     - cut-in events
#
# Render with:  d2 --layout=elk D2_dataflow_cutin.d2 D2_dataflow_cutin.svg
#
# Visual conventions
#   - SQLite tables being *populated* in a diagram use the built-in sql_table
#     shape, so columns + key constraints are visible.
#   - Tables that appear only as upstream inputs use the `table_ref` class
#     (cylinder, blue) to stay compact.
#   - nuScenes records / map API use the `nuscenes` class (page, yellow).
#   - Query / post-processing steps use the `config` class (rectangle, grey).

grid-rows: 1
vertical-gap: 0
horizontal-gap: 40

classes: {
  nuscenes: {
    shape: page
    style: {
      fill: "#fff4d6"
      stroke: "#8a6a00"
      font-color: "#3a2a00"
    }
  }
  table_ref: {
    shape: cylinder
    style: {
      fill: "#dbeafe"
      stroke: "#1e3a8a"
      font-color: "#0b1c40"
      font-size: 24
    }
  }
  ui_element: {
    shape: rectangle
    style: {
      fill: "#dcfce7"
      stroke: "#15803d"
      font-color: "#0a4720"
    }
  }
  config: {
    shape: rectangle
    style: {
      fill: "#f3f4f6"
      stroke: "#6b7280"
      font-color: "#374151"
    }
  }
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram - Intermediate: kinematic_features (KF)
# Per-frame ego-relative kinematics cache, built from ego_poses + object_poses.
# ────────────────────────────────────────────────────────────────────────────

"Populate intermediate table: `kinematic_features`": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    ego_poses: { class: table_ref }
    object_poses: { class: table_ref }
  }

  derived: {
    label: "Intermediate data table"
    style.fill: "#fdebf3"
    style.stroke: "#9d174d"

    kinematic_features: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      frame_idx: INTEGER
      actor_token: TEXT
      is_ego: INTEGER
      yaw: REAL
      speed: REAL
      s_rel_ego: REAL
      l_rel_ego: REAL
      perpendicular_displacement: REAL
    }
  }

  inputs.ego_poses -> derived.kinematic_features: "ego pose\n(Frenet origin),\nego yaw + speed" {
    style.font-size: 24
    style.font-color: "#000000"
  }
  inputs.object_poses -> derived.kinematic_features: "actor pose,\nactor yaw + speed" {
    style.font-size: 24
    style.font-color: "#000000"
  }
}


# ────────────────────────────────────────────────────────────────────────────
# Diagram - Derived: cut-in events
# Sliding window over kinematic_features flags lateral lane intrusions.
# ────────────────────────────────────────────────────────────────────────────

"Populate `cutin_events` table": {
  direction: down

  inputs: {
    label: "Inputs"
    style.fill: "#eef4ff"
    style.stroke: "#1e3a8a"
    direction: right

    kinematic_features: { class: table_ref }
  }

  derived: {
    label: "Derived event table"
    style.fill: "#fdebf3"
    style.stroke: "#9d174d"

    cutin_events: {
      shape: sql_table
      scene_token: TEXT { constraint: foreign_key }
      vehicle_id: TEXT
      start_frame: INTEGER
      end_frame: INTEGER
    }
  }

  inputs.kinematic_features -> derived.cutin_events: "l_rel_ego, s_rel_ego,\nyaw, perpendicular_displacement\n(per non-ego actor)" {
    style.font-size: 24
    style.font-color: "#000000"
  }
}
